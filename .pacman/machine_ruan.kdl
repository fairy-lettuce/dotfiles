// machine_ruan.kdl — ruan の導入意図(pkgnote 管理)

machine "ruan" {
    tool {
        cli {
            terminal {
                package "alacritty" include=#true
            }

            monitor {
                package "btop" include=#true
                package "nvtop" include=#true
            }

            misc {
                package "fastfetch" include=#true
                package "evtest" include=#true
                package "sl" include=#true
            }

            text-editor {
                package "helix" include=#true
                package "nano" include=#true
                package "neovim" include=#true
            }

            decoration {
                package "powerline" include=#true
                package "matugen" include=#true
            }

            hardware {
                package "kanshi" include=#true
            }

            man {
                package "less" include=#true
                package "man-db" include=#true
                package "man-pages" include=#true
                package "man-pages-ja" include=#true
            }

            filer {
                package "thunar" include=#true
                package "yazi" include=#true
            }

            multiplexer {
                package "tmux" include=#true
                package "zellij" include=#true
            }
        }

        gui {
            ime {
                package "fcitx5" include=#true
                package "fcitx5-configtool" include=#true
                package "fcitx5-gtk" include=#true
                package "fcitx5-qt" include=#true
                package "fcitx5-hazkey-bin" include=#true
                package "fcitx5-mozc-ut" include=#true
                package "hazkey-zenzai-model" include=#true
                package "mozc-ut" include=#true
            }

            remote-control {
                package "moonlight-qt" include=#true
                package "sunshine" include=#true
                package "freerdp" include=#true
                package "apollo" include=#true
                package "artemis-qt-git" include=#true
            }

            filer {
                package "nemo" include=#true
                package "ffmpegthumbnailer" include=#true
            }

            audio-visual {
                package "vlc" include=#true
                package "obs-studio" include=#true
                package "vlc-plugin-ffmpeg" include=#true
                package "com.obsproject.Studio" include=#false
            }

            wallpaper {
                package "awww-bin" include=#true
                package "swaybg" include=#true
            }

            browser {
                package "brave-bin" include=#true
            }

            font {
                package "font-manager" include=#true
                package "fontforge" include=#true
                package "ttfautohint" include=#true
            }

            picker {
                package "fuzzel" include=#true
                package "wofi" include=#true
            }

            officesuite {
                package "libreoffice-still" include=#true
                package "libreoffice-still-ja" include=#true
            }

            notification {
                package "mako" include=#true
            }

            texteditor {
                package "obsidian" include=#true
            }

            system-ui {
                package "swayidle" include=#true
                package "swaylock" include=#true
                package "waybar" include=#true
                package "waybar-niri-windows-bin" include=#true
                package "wlogout" include=#true
            }

            social {
                package "com.discordapp.Discord" include=#true
            }
        }
    }

    creative {
        "3D" {
            package "blender" include=#true
        }

        illust {
            package "krita" include=#true
        }

        modeling {
            package "blender" include=#true
            package "blender-plugin-fspy" include=#true
            package "fspy" include=#true
            package "fspy-debug" include=#true
        }

        voice {
            package "coeiroink" include=#true
            package "voicevox-appimage" include=#true
        }
    }

    system {
        greeter {
            package "cage" include=#true
            package "greetd" include=#true
            package "greetd-regreet" include=#true
            package "lightdm" include=#true
            package "lightdm-gtk-greeter" include=#true
        }

        font {
            package "adobe-source-han-sans-jp-fonts" include=#true
            package "adobe-source-han-serif-jp-fonts" include=#true
            package "noto-fonts" include=#true
            package "noto-fonts-cjk" include=#true
            package "noto-fonts-emoji" include=#true
            package "otf-ipaexfont" include=#true
            package "powerline-fonts" include=#true
            package "ttf-rounded-mgenplus" include=#true
            package "ttf-udev-gothic" include=#true

            cjk {
                package "adobe-source-han-sans-jp-fonts" include=#true
                package "adobe-source-han-serif-jp-fonts" include=#true
                package "noto-fonts-cjk" include=#true
                package "otf-ipaexfont" include=#true
                package "ttf-rounded-mgenplus" include=#true
                package "ttf-udev-gothic" include=#true
            }

            latin {
                package "noto-fonts" include=#true
                package "maplemono-nf" include=#true
                package "maplemononl-nf" include=#true
            }

            other {
                package "noto-fonts-emoji" include=#true
                package "otf-font-awesome" include=#true
                package "powerline-fonts" include=#true
            }
        }

        kernel {
            package "base" include=#true
            package "base-devel" include=#true
            package "linux" include=#true
            package "linux-firmware" include=#true
            package "linux-headers" include=#true
        }

        network {
            package "networkmanager" include=#true
            package "firewalld" include=#true
        }

        compositor {
            package "niri" include=#true
            package "sway" include=#true
        }

        shell {
            package "zsh" include=#true
            package "fish" include=#true
            package "powershell-bin" include=#true
        }

        job-scheduler {
            package "at" include=#true
            package "cronie" include=#true
        }

        base {
            package "base" include=#true
            package "base-devel" include=#true
        }

        bluetooth {
            package "bluez" include=#true
        }

        boot {
            package "efibootmgr" include=#true
            package "grub" include=#true
            package "os-prober" include=#true
        }

        package-manager {
            package "flatpak" include=#true
            package "pacman-contrib" include=#true
            package "yay" include=#true
        }

        keyring {
            package "gnome-keyring" include=#true
        }

        device {
            package "ntfs-3g" include=#true
        }

        gpu {
            package "nvidia-open" include=#true
            package "nvidia-utils" include=#true
        }

        audio {
            package "pipewire-alsa" include=#true
            package "pipewire-pulse" include=#true
        }

        portal {
            package "xdg-desktop-portal" include=#true
            package "xdg-desktop-portal-gnome" include=#true
            package "xdg-desktop-portal-gtk" include=#true
            package "xdg-desktop-portal-wlr" include=#true
        }

        camera {
            package "anker-powerconf-c200-linux-tools" include=#true
        }
    }

    dev {
        c-sharp {
            package "dotnet-runtime" include=#true
            package "dotnet-sdk" include=#true
            package "dotnet-sdk-9.0" include=#false
            package "dotnet-sdk-7.0-bin" include=#true
            package "powershell-bin" include=#true
        }

        r {
            package "r" include=#true
        }

        cpp {
            package "clang" include=#true
        }

        fortran {
            package "gcc-fortran" include=#true
        }

        coding-agent {
            package "gemini-cli" include=#true
            package "ollama-cuda" include=#true
            package "antigravity-cli" include=#true
            package "claude-code" include=#true
            package "claude-desktop-bin" include=#true
        }

        tool {
            package "git" include=#true
            package "github-cli" include=#true
        }

        toolchain {
            package "lld" include=#true
            package "nasm" include=#true
        }

        rust {
            package "rustup" include=#true
        }

        package-manager {
            package "uv" include=#true
        }

        ide {
            package "code-marketplace" include=#true
            package "visual-studio-code-bin" include=#true
            package "vscodium-bin" include=#true
            package "vscodium-marketplace" include=#true
        }
    }

    game {
        util {
            package "gamemode" include=#true
            package "gamescope" include=#true
            package "mangohud" include=#true
            package "wine" include=#true
            package "lgx2userspace-git" include=#true
            package "lib32-gamemode" include=#true
            package "lib32-mangohud" include=#true
            package "wine-mono" include=#true
            package "winetricks" include=#true
        }

        platform {
            package "steam" include=#true
        }

        games {
            package "wine-mono" include=#true
            package "winetricks" include=#true
            package "tetrio-desktop" include=#true
        }
    }
}
