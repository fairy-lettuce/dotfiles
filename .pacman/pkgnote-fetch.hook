# pkgnote fetch hook
#
# 現状: **無効**。以前は pacman.conf の HookDir に ~/.pacman/ を登録して有効にしていたが、
# ユーザーが書き換えられる場所の hook / スクリプトを root が実行するのは危険なので、
# HookDir の登録は外した。root 所有の /etc/pacman.d/hooks/ への配置と、ヘルパー
# (pkgnote-fetch.sh)を root 所有のパスへ移すことは未実施(TODO)。それまでは
# `pkgnote fetch` を手動で実行する。
#
# 入力: pkgnote fetch は `pacman -Qqen` / `-Qqem` / `flatpak list` を自分で問い合わせるので、
# 他の hook(旧 pkglist.hook。削除済み)との実行順序には依存しない。
#
# 失敗時の挙動: PostTransaction フックは非ゼロ終了してもトランザクションに影響しない
# (トランザクションはフック実行前に完了済み)。念のため `|| true` で握りつぶす。
# pkgnote fetch 側も、問い合わせ失敗やデータ不整合のときは何も書かずに終了する。
#
# 実行ユーザー: pacman は root で hook を実行する。実処理は pkgnote-fetch.sh に委譲し、
# その中で runuser で呼び出しユーザー($SUDO_USER)のログイン環境に降りて pkgnote
# (uv/venv/KDL/git は全てユーザー所有)を走らせる。$SUDO_USER をパスに使うのは、
# root の $HOME(=/root)を踏まないため & 特定ユーザー名をハードコードしないため。
# sudo 経由でない直接 root 実行時は $SUDO_USER 未設定で no-op になる。
# (root 所有パスへ移す際は、Exec のパスも合わせて変えること。)

[Trigger]
Operation = Install
Operation = Remove
Type = Package
Target = *

[Action]
Description = pkgnote: syncing package notes (KDL) after installs/removes...
When = PostTransaction
Exec = /bin/sh -c 'test -n "$SUDO_USER" && sh "/home/$SUDO_USER/.pacman/pkgnote-fetch.sh" || true'
