creative install-if="personal" {
    modeling {
        package "blender" from="pacman" first-installed-on="ruan"
        package "blender-plugin-fspy" from="foreign" first-installed-on="ruan"
        package "fspy" from="foreign" first-installed-on="ruan"
        package "nanoem-git-local" from="foreign" first-installed-on="ruan"
    }

    illust {
