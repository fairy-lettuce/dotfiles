    }

    voice {
        package "coeiroink" from="foreign" first-installed-on="ruan"
        package "voicevox-appimage" from="foreign" first-installed-on="ruan"
    }

    font {
        package "fontforge" from="pacman" first-installed-on="ruan"
        package "ttfautohint" from="foreign" first-installed-on="ruan"
    }
}

game install-if="gaming" {
    platform {
        package "steam" from="pacman" first-installed-on="ruan"
        package "lutris" from="pacman" first-installed-on="ruan"
    }

    util {
        package "gamemode" from="pacman" first-installed-on="ruan"
