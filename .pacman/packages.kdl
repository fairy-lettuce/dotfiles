        package "gamescope" from="pacman" first-installed-on="ruan"
        package "wine" from="pacman" first-installed-on="ruan"
        package "mangohud" from="pacman" first-installed-on="ruan"
        package "lib32-mangohud" from="pacman" first-installed-on="ruan"
        package "wine-mono" from="pacman" first-installed-on="ruan"
        package "winetricks" from="pacman" first-installed-on="ruan"
        package "com.usebottles.bottles" from="flatpak" first-installed-on="ruan"
    }

    games {
        package "tetrio-desktop" from="foreign" first-installed-on="ruan"
    }

    driver {
        package "vulkan-tools" from="pacman" first-installed-on="ruan"
        package "xone-dkms" from="foreign" install-if="ruan" first-installed-on="ruan"
        package "lgx2userspace-git" from="foreign" install-if="ruan" first-installed-on="ruan"
    }

    rta {
        package "livesplit-one-druid" from="foreign" first-installed-on="ruan"
    }
}

