    gui {
        audio-visual {
            package "vlc" from="pacman" first-installed-on="ruan"
            package "vlc-plugin-ffmpeg" from="pacman" first-installed-on="ruan"
            package "obs-studio" from="pacman" install-if="personal" first-installed-on="ruan"
