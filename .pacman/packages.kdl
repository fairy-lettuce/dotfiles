// pkgnote packages.kdl — 手動編集可(pkgnote fetch/categorize が追記)

tool {
    cli {
        terminal {
            package "alacritty" from="pacman" first-installed-on="ruan"
        }

        multiplexer {
            package "zellij" from="pacman" first-installed-on="ruan"
            package "tmux" from="pacman" first-installed-on="ruan"
        }

        text-editor {
