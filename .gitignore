# gitignore for dotfiles
# local-only files
.zshrc.local
.config/fish/local.fish
.config/fish/fish_variables
# dotfiles: per-machine settings (e.g. wallpaper-random.local)
.config/dotfiles/*.local

# files containing credentials etc.
.config/gh/hosts.yml
.config/atcoder-cli-nodejs/config.json

# do not track noisy directories

.config/blender
.config/BraveSoftware
.config/chromium
.config/Code
.config/Code - OSS
.config/Claude
.config/Claude-3p
.config/coeiroink-v2
.config/configstore
.config/dconf
.config/devin
.config/discord
.config/Electron
.config/font-manager
.config/freerdp
.config/fspy
.config/gconf
.config/go
.config/google-chrome
.config/ibus
.config/libreoffice
.config/matplotlib
.config/menus
.config/microsoft-edge
.config/Moonlight Game Streaming Project
.config/mozc
.config/Nextcloud
.config/NuGet
.config/obs-studio
.config/obsidian
.config/opencode
.config/opera
.config/pacher-studio
.config/procps
.config/pulse
.config/rclone
.config/remmina
.config/Slack
.config/sunshine
.config/tetrio-desktop
.config/unity3d
.config/VA_11_Hall_A
.config/vivaldi
.config/vlc
.config/voicevox
.config/VSCodium

# cache

.config/fcitx5/conf/cached_layouts
.config/csharp.history
.config/QtProject.conf
.config/easyeffectsrc
.config/kritarc
.config/kritadisplayrc
.config/zoom*.conf
.config/Artemis Desktop Project/Artemis.conf

# large binary for testing
.local/bin/niri

# Python/uv related files
.venv/
__pycache__/
*.pyc

# matugen outputs (generated from .config/matugen/templates)
.config/waybar/colors.css
.config/alacritty/themes/colors.toml
.config/mako/config
.config/fuzzel/colors.ini
.config/swaylock/config
.config/wlogout/style.css
.config/gtk-3.0/gtk.css
.config/gtk-4.0/gtk.css
.config/matugen/generated/
.config/zellij/themes/shakimofu.kdl
.config/starship.toml
.config/helix/themes/shakimofu.toml
.local/share/fcitx5/themes/shakimofu/
.config/matugen/themes/dynamic.json
