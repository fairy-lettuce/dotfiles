# System units enabled by deploy-dotfiles.sh (sudo systemctl enable; never started).
# Same syntax as systemd preset files: "enable <unit>" per line.
# Per-machine lists: add "<name>.list##class.<class>" (yadm alternates).
enable NetworkManager.service
enable bluetooth.service
enable firewalld.service
enable greetd.service
enable sshd.service
enable tailscaled.service
