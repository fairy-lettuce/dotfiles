// Generated by matugen
<* if {{ is_dark_mode }} *>
themes {
    shakimofu {
        fg "{{ theme.foreground.dark.hex }}"
        bg "{{ theme.background.dark.hex }}"
        black "{{ theme.black.dark.hex }}"
        red "{{ theme.red.dark.hex }}"
        green "{{ theme.green.dark.hex }}"
        yellow "{{ theme.yellow.dark.hex }}"
        blue "{{ theme.blue.dark.hex }}"
        magenta "{{ theme.magenta.dark.hex }}"
        cyan "{{ theme.cyan.dark.hex }}"
        white "{{ theme.white.dark.hex }}"
        orange "{{ theme.orange.dark.hex }}"
    }
}
<* else *>
themes {
    shakimofu {
        fg "{{ theme.foreground.light.hex }}"
        bg "{{ theme.background.light.hex }}"
        black "{{ theme.black.light.hex }}"
        red "{{ theme.red.light.hex }}"
        green "{{ theme.green.light.hex }}"
        yellow "{{ theme.yellow.light.hex }}"
        blue "{{ theme.blue.light.hex }}"
        magenta "{{ theme.magenta.light.hex }}"
        cyan "{{ theme.cyan.light.hex }}"
        white "{{ theme.white.light.hex }}"
        orange "{{ theme.orange.light.hex }}"
    }
}
<* endif *>
